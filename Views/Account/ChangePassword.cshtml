@{
    ViewData["Title"] = "Zmiana hasła";
    bool firstLogin = ViewBag.FirstLogin ?? false;
}

<h2>Zmiana hasła</h2>

@if (firstLogin)
{
    <p style="color: darkorange; font-weight: bold;">
        Wymuszona zmiana hasła (pierwsze logowanie lub hasło wygasło). Podaj nowe hasło dwukrotnie.
    </p>
}

@if (ViewBag.Error != null)
{
    <p style="color: red; font-weight: bold;">@ViewBag.Error</p>
}

<form method="post" asp-action="ChangePassword">
    <input type="hidden" name="firstLogin" value="@firstLogin.ToString().ToLower()" />

    @if (!firstLogin)
    {
        <div>
            <label>Stare hasło:</label><br />
            <input type="password" name="oldPassword" required />
        </div>
    }

    <div style="margin-top: 10px;">
        <label>Nowe hasło:</label><br />
        <input type="password" name="newPassword" required />
    </div>

    <div style="margin-top: 10px;">
        <label>Powtórz nowe hasło:</label><br />
        <input type="password" name="confirmPassword" required />
    </div>

    <div style="margin-top: 15px;">
        <button type="submit">Zmień hasło</button>
    </div>
</form>